# Supabase - required for production data fetch
# Replace stub in lib/keyword-data.ts with Supabase queries when these are set.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Management API token - required for scripts/db-migrate.mjs
# Get one at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your-access-token

# Site base URL - used for canonical tags and sitemap
NEXT_PUBLIC_SITE_URL=https://packlinx.co.kr
